{
  "name": "insight-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "next build --webpack",
    "start": "NODE_USE_ENV_PROXY=1 next start",
    "seed": "NODE_USE_ENV_PROXY=1 tsx evals/seed.ts",
    "db:migrate": "tsx ops/run-provenance-migrations.ts",
    "deployment:record": "tsx ops/record-deployment.ts",
    "redaction:replay": "tsx ops/replay-redaction-registry.ts",
    "db:snapshot": "node ops/db-snapshot.mjs",
    "db:restore": "node ops/db-restore.mjs",
    "db:backup": "node --no-warnings ops/backup-db.mjs",
    "branches:cleanup": "node ops/cleanup-merged-branches.mjs",
    "branches:cleanup:test": "node --test ops/cleanup-merged-branches.node-test.mjs",
    "eval:a1": "tsx evals/run-a1.ts",
    "eval:provenance-integrity": "tsx evals/provenance-dashboard-integrity-v1.ts",
    "eval:opportunity-map": "tsx evals/score-opportunity-map.ts",
    "eval:build-local": "tsx evals/build-local-eval.ts",
    "benchmark:provenance-p0c": "tsx evals/provenance-p0c-benchmark.ts",
    "pr:policy": "node ops/pr-policy.mjs",
    "review:sheet": "tsx evals/make-review-sheet.ts",
    "review:csv": "tsx evals/make-review-csv.ts",
    "lint": "eslint src ops evals eslint.config.mjs next.config.mjs vitest.config.ts --max-warnings=0",
    "typecheck": "npm run typecheck:ts7 && npm run typecheck:ts6",
    "typecheck:ts7": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:ts6": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@aws-sdk/client-kms": "3.1112.0",
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/client-secrets-manager": "3.1112.0",
    "@aws-sdk/client-sts": "3.1112.0",
    "better-sqlite3": "12.11.1",
    "d3-force": "3.0.0",
    "fast-xml-parser": "5.11.0",
    "image-size": "file:vendor/image-size",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/d3-force": "3.0.10",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "image-size": "$image-size",
    "nanoid": "3.3.18",
    "nodemailer": "9.0.5",
    "sharp": "0.35.0",
    "postcss": "8.5.26"
  }
}
