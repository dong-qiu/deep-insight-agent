{
  "name": "insight-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9 <21",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 next start",
    "seed": "NODE_USE_ENV_PROXY=1 tsx evals/seed.ts",
    "db:snapshot": "node ops/db-snapshot.mjs",
    "db:restore": "node ops/db-restore.mjs",
    "db:backup": "node --no-warnings ops/backup-db.mjs",
    "eval:a1": "tsx evals/run-a1.ts",
    "eval:opportunity-map": "tsx evals/score-opportunity-map.ts",
    "eval:build-local": "tsx evals/build-local-eval.ts",
    "pr:policy": "node ops/pr-policy.mjs",
    "review:sheet": "tsx evals/make-review-sheet.ts",
    "review:csv": "tsx evals/make-review-csv.ts",
    "lint": "eslint src ops evals eslint.config.mjs next.config.mjs vitest.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "better-sqlite3": "12.11.1",
    "d3-force": "3.0.0",
    "fast-xml-parser": "5.10.1",
    "next": "15.5.21",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.0.3",
    "pino": "10.3.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nodemailer": "9.0.3",
    "sharp": "0.35.0",
    "postcss": "8.5.22"
  }
}
