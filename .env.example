# Anthropic API key —— A1 验证实跑（npm run eval:a1）必需
# 复制本文件为 .env.local 并填入真实 key（.env* 已在 .gitignore，不会入仓）
ANTHROPIC_API_KEY=sk-ant-...

# 覆盖默认模型（架构默认 分析=sonnet-4-6 / 校验=opus-4-7）
# 校验模型必须独立于分析模型（同源偏差约束），否则启动即报错。
# ⚠️ 经 Opus-only 中转站时**必须**把 analyzer 显式设为 Opus（否则 analyze 打到 sonnet → 失败）：
#   ANALYZER_MODEL=claude-opus-4-6   # 与下方 validator 不同即可
# ANALYZER_MODEL=claude-sonnet-4-6
# VALIDATOR_MODEL=claude-opus-4-7

# 可选：经第三方中转站时设置（直连 Anthropic 则留空）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 经第三方中转站时建议关校验思考（部分中转站 thinking 计价虚高/不稳，见 docs/practice-log.md）
# VALIDATOR_THINKING=0

# 鉴权（NextAuth）—— Web 应用必需
# AUTH_SECRET：随机串，`openssl rand -base64 32` 生成
AUTH_SECRET=
# 管理员凭据（MVP 用 Credentials 登录；magic-link 待接 SMTP 后启用）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 定时管线（Docker：容器内 supercronic 按 ops/crontab 触发 POST /api/cron）
# CRON_SECRET：随机串（`openssl rand -base64 32`）。未设置则 /api/cron 返回 503 禁用。
CRON_SECRET=
# P0a durable Deep Dive dispatch：仅 Docker 内 worker 调用内部 dispatch 接口，必须与 AUTH_SECRET 不同。
# `openssl rand -base64 32` 生成；未配置时 worker 与入口均 fail-closed。
DISPATCH_WORKER_SECRET=
# P1c immutable report anchors are opt-in. Keep this false until the INSI-25
# Object Lock/KMS/IAM/key-retention admission checklist is complete. When true,
# the dispatch composition root rejects publication if any required material is
# absent; no in-memory fallback exists.
# INTEGRITY_ANCHOR_ENABLED=false
# Required only when enabled. This opaque, immutable INSI-25 evidence reference
# must exactly match the protected GitHub Production environment variable; the
# deployment rejects an unmatched host-only change before it stops writers.
# INTEGRITY_ANCHOR_ADMISSION_REF=INSI-25:<immutable-evidence-id>
# S3 authentication uses the deployment's AWS role/default provider chain.
INTEGRITY_ANCHOR_BUCKET=
INTEGRITY_ANCHOR_KEY_ID=anchor-key-v1
# PEM may be supplied with literal \n escapes by a secret manager; never commit it.
INTEGRITY_ANCHOR_PRIVATE_KEY_PEM=
# Optional floor for the Object Lock horizon (defaults to 100 days). The writer
# takes the maximum of this and the three mandatory policy end instants below.
# INTEGRITY_ANCHOR_RETAIN_DAYS=
# Required absolute policy ends. Publication and integrity maintenance fail
# closed when any is missing or expired, so evidence cannot outlive its lock.
INTEGRITY_REPORT_READABLE_UNTIL=
INTEGRITY_REPORT_ARCHIVE_UNTIL=
INTEGRITY_ARTIFACT_RETAIN_UNTIL=
# 可选：Deep Dive 的 Idempotency-Key HMAC 专用密钥；缺省才回退 AUTH_SECRET。
# PROVENANCE_IDEMPOTENCY_SECRET=
# P0a 删除登记册恢复 runner（仅受控恢复命令需要；均为 ARN/版本号而非 secret 本体）。
# web/worker 不读取这些变量；runner 会从实例角色临时 AssumeRole 到独立 recovery role，失败即拒绝恢复。
# REDACTION_REGISTRY_BUCKET=deep-insight-redaction-registry-123456789012
# REDACTION_REGISTRY_PREFIX=records/
# REDACTION_REGISTRY_KMS_KEY_ID=alias/deep-insight-redaction-registry
# REDACTION_RECOVERY_ROLE_ARN=arn:aws:iam::123456789012:role/deep-insight-redaction-recovery
# REDACTION_HMAC_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:deep-insight/redaction-hmac/v1-xxxx
# REDACTION_HMAC_KEY_VERSION=v1
# 多版本 HMAC 过渡时替代上面二项：{"v1":"arn:...:secret:...","v2":"arn:...:secret:..."}
# REDACTION_HMAC_SECRET_ARNS_JSON=
# P0a 运行版本事实源：生产发布器应注入 repo@sha256 的 digest；本地开发留空并将 trace 标记为 partial。
# INSIGHT_IMAGE_DIGEST=sha256:...
# 严格生产启动由 GitHub 发布流程注入并设为 1；本地 Compose 显式保持默认 0，不能伪造 deployment record。
# PROVENANCE_DEPLOYMENT_REQUIRED=1
# 可选：单次跑回看窗口小时数（默认 168 = 7 天），按主题切此窗口内的 ContentItem
# PIPELINE_WINDOW_HOURS=168
# 可选：冷启动（topic 无历史报告）自动产"首版综述"initial_digest——更宽回看窗口 + 更多条，给新主题有份量的首报
# INITIAL_DIGEST_WINDOW_HOURS=720   # 默认 720 = 30 天
# INITIAL_DIGEST_ITEMS=25           # 默认 25（暖启动后回落到 PIPELINE_ITEMS_PER_TOPIC=15）

# 可选：失败告警 webhook（Run 失败时 fire-and-forget POST）。按 URL 自动识别渠道并翻译 payload：
#   feishu（默认主推）/ ntfy / slack / discord / generic。未设则不发（失败仍落 Run + error 日志）。
#   operator 配置、非用户输入。详见 docs/launch/operations.md §12。
# ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx
# 可选：显式指定渠道，覆盖 URL 自动识别（自建 ntfy 用自定义域名时设 ntfy）。取值 feishu/ntfy/slack/discord/generic
# ALERT_CHANNEL=feishu
# 可选：飞书群机器人开「签名校验」安全模式时填密钥（自动加 timestamp+sign）；用「关键词」模式则留空
# ALERT_FEISHU_SECRET=
# 可选：告警发送超时毫秒（默认 5000）
# ALERT_TIMEOUT_MS=5000

# 可选：报告推送（生成完报告主动推给用户，点进 = 报告 deep-link）。复用上面同一 ALERT_WEBHOOK 渠道。
#   独立 opt-in：默认关（失败告警是运维信号、报告推送是日常内容流，混同渠道默认全开会刷屏）。
#   置 1 开启；空 brief（"本期无重要事件"）自动跳过，deep_dive/initial_digest 始终推。
# REPORT_PUSH=1
# P0a Brief 验收观察器：下一次 Brief 非空且所有发布引用均来自 pass/support 白名单、并已写入 report output ref 才通过。
# 仅观察期使用；未达标（含正常空刊）才复用 ALERT_WEBHOOK 告警，通过后静默。完成 P0a Brief 验收后关闭。
# BRIEF_ACCEPTANCE_WATCH=1
# 用户可达的站点根地址，用于拼报告 deep-link（如 https://insight.example.com 或 http://<EC2-IP>:3000）。
#   缺失则推送照发、仅不带链接。注意与容器内网 APP_URL（http://app:3000）区分。
# PUBLIC_BASE_URL=https://insight.example.com
# 可选：报告推送的【邮件渠道】（SMTP · nodemailer）——报告推送会同时扇出到飞书 webhook + 邮件。
#   需 REPORT_PUSH=1 + 下面 SMTP_HOST + REPORT_EMAIL_TO 都配齐才发邮件（缺一即跳过邮件、不影响飞书）。
#   运维告警（失败/预算）不发邮件、仍只走飞书 webhook。SMTP 授权码用邮箱商的「客户端授权码」（非登录密码）。
# SMTP_HOST=smtp.qq.com           # 如 QQ smtp.qq.com / 163 smtp.163.com / Gmail smtp.gmail.com / 企业邮
# SMTP_PORT=465                   # 465=隐式 TLS（默认）；587=STARTTLS
# SMTP_USER=you@qq.com
# SMTP_PASS=<邮箱客户端授权码>
# SMTP_FROM=you@qq.com            # 发件人，缺省回退 SMTP_USER
# REPORT_EMAIL_TO=a@x.com,b@x.com # 收件人【兜底】：现以「设置页→邮件分发收件人」（入库）为准，
#   库里有启用收件人即以库为准；REPORT_EMAIL_TO 仅在库为空时回落。多收件人逗号分隔。

# 可选：成本预算控制（A5 · DCP-3 ①，见 docs/launch/operations.md §14）。配上限即触顶自动熔断定时管线。
#   ⚠️ 持久化提醒：这几个 + 上面 REPORT_PUSH/PUBLIC_BASE_URL 是「生产手动配的运行时配置」。
#   ops/aws/deploy.sh 会用本地 .env.local 全量覆盖远程——务必把生产值写进本地 .env.local，否则
#   下次 deploy 会静默抹掉熔断/推送（gen-env.sh 已自动继承旧值；deploy.sh 缺失会告警）。
#   取消注释时只删行首 #、保留裸 KEY=VAL（勿加行内注释，会被当值导致解析失败/熔断失效）。
# 日成本上限 USD；触顶熔断（跳过剩余 topic）+ 告警。未设 = 不限
# COST_LIMIT_DAILY=5
# 月成本上限 USD（自然月 UTC）；同上熔断 + 告警。未设 = 不限
# COST_LIMIT_MONTHLY=80
# 触顶前告警阈值百分比（默认 80）
# COST_ALERT_PCT=80

# —— 仅容器部署需要（本地 dev 勿设）——
# INSIGHT_CONFIG_PATH：standalone 打包后 defaults.yaml 的绝对路径（Dockerfile 已设 /app/config/defaults.yaml）
# DATA_DIR / DB_PATH：SQLite 库与归档目录（Dockerfile 已设 /data，挂持久卷）
